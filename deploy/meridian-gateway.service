# IB Gateway kept logged in by IBC (https://github.com/IbcAlpha/IBC), so the
# paper cycle finds port 4002 open every morning. The gateway draws on the
# meridian-xvfb virtual display, so it needs no desktop session and runs on a
# headless box; linger (set by deploy/install-appliance.sh) starts it at boot.
#
# One-time setup (as the appliance user):
#   1. Install IB Gateway (under ~/Jts/ibgateway/<version>).
#   2. Unzip the IBC Linux release to ~/ibc; chmod +x ~/ibc/*.sh ~/ibc/scripts/*.sh
#   3. In ~/ibc/gatewaystart.sh set IBC_PATH=$HOME/ibc and TWS_MAJOR_VRSN
#      to the installed version folder (the script ignores the environment).
#   4. Edit ~/ibc/config.ini: IbLoginId / IbPassword = the PAPER credentials,
#      TradingMode=paper, AcceptIncomingConnectionAction=accept, ReadOnlyApi=no,
#      OverrideTwsApiPort=4002, ExistingSessionDetectedAction=primary,
#      IbDir=$HOME/Jts.  chmod 600 ~/ibc/config.ini (it holds the password)
#   5. deploy/install-appliance.sh
#
# IBC restarts the gateway through its daily logout; two-factor still needs the
# phone prompt on the first login after each full restart.

[Unit]
Description=IB Gateway (paper) kept logged in by IBC
Requires=meridian-xvfb.service
After=meridian-xvfb.service network-online.target
OnFailure=meridian-alert@%n.service

[Service]
Type=simple
Environment=DISPLAY=:99
ExecStart=%h/ibc/gatewaystart.sh -inline
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
