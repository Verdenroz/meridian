# Meridian paper cycle: trades the previous close's shadow decision on the
# IBKR paper gateway. A user unit, since IB Gateway needs the desktop session.
#
# Install: deploy/install-appliance.sh. Then:
#   systemctl --user list-timers            # next firing
#   journalctl --user -u meridian-paper-cycle -f
#
# IB Gateway must already be logged in (see meridian-gateway.service).

[Unit]
Description=Meridian paper cycle on the IBKR paper gateway
OnFailure=meridian-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/meridian
ExecStart=%h/projects/meridian/deploy/paper-cycle.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# MERIDIAN_ALERT_WEBHOOK (same contract as the bus); absent = journal only.
EnvironmentFile=-%h/.config/meridian/alert.env
