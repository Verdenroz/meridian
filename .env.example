# Training/runtime credentials and endpoints
FRED_API_KEY=
COINGECKO_API_KEY=

# HuggingFace — write-access token used by `make collect` / `make pack-fda`
# to upload real shards and packed FDA synth tars. Create at:
#   https://huggingface.co/settings/tokens  (needs WRITE scope)
# Leave HF_TOKEN empty to skip upload (everything still runs locally).
HF_TOKEN=
HF_DATA_REPO=Verdenroz/meridian-data
HF_DATA_PRIVATE=1
# FDA tars upload into HF_DATA_REPO under fda_tars/ by default; override only to
# split them into a separate repo. FDA_TAR_PRIVATE defaults to HF_DATA_PRIVATE.
# FDA_TAR_REPO=Verdenroz/meridian-data
# FDA_TAR_PATH=fda_tars
# FDA_TAR_PRIVATE=1

# Optional storage overrides
MERIDIAN_DATA_ROOT=./data
MERIDIAN_CHECKPOINT_ROOT=./checkpoints
